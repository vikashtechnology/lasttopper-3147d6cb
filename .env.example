# Public Supabase configuration (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only configuration (never expose through VITE_* variables)
SUPABASE_SERVICE_ROLE_KEY=replace_me
# Random high-entropy secret for lifecycle/withdrawal hooks. Send it as
# Authorization: Bearer <secret> or X-Internal-Hook-Secret: <secret>.
INTERNAL_HOOK_SECRET=replace_with_a_random_32_byte_secret

# Public deployment URL and native deep-link host
VITE_PUBLIC_APP_URL=https://last-topper-web-test.vercel.app
CAPACITOR_SERVER_URL=https://last-topper-web-test.vercel.app

# AI providers (configure at least one chat provider)
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY_1=
OMNIROUTE_API_KEY_2=
OMNIROUTE_API_KEY_3=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
XAI_API_KEY=

# Image generation (OpenAI-compatible Images API)
# Set IMAGE_API_KEY, or use OPENAI_API_KEY with the default endpoint.
IMAGE_API_KEY=
OPENAI_API_KEY=
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-1

# Search references
FIRECRAWL_API_KEY=

# Telegram alerts and admin commands
TELEGRAM_API_KEY=
TELEGRAM_API_KEY_1=
REPORT_TELEGRAM_CHAT_ID=

# WhatsApp integration
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Google configuration check
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
