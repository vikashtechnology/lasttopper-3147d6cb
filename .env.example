# Last Topper — consolidated staging environment template
# Copy to .env for local work and to Vercel Preview environment variables.
# Never commit populated secret values. Start with a separate Firebase staging project.

# ── Public application URL ────────────────────────────────────────────────────
VITE_PUBLIC_APP_URL=https://YOUR-STAGING-DEPLOYMENT.vercel.app

# ── Firebase Web app (public browser configuration) ───────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR-STAGING-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR-STAGING-PROJECT-ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR-STAGING-PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (server-only; never prefix these with VITE_) ───────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=YOUR-STAGING-PROJECT-ID
# Preferred: compact raw JSON or base64 of the entire downloaded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON (leave blank when using the JSON value).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── ImgBB (server-only image uploads, always expire after 604800 seconds) ──────
# https://api.imgbb.com/ → Get API key
IMGBB_API_KEY=

# ── Mega Test lifecycle scheduler ─────────────────────────────────────────────
# Generate a random 32+ character secret. Use the SAME value in Vercel Preview
# and GitHub Actions repository secret INTERNAL_HOOK_SECRET.
INTERNAL_HOOK_SECRET=
# GitHub repository variable only (not read by the app):
MEGA_LIFECYCLE_URL=https://YOUR-STAGING-DEPLOYMENT.vercel.app/api/public/hooks/mega-test-lifecycle

# ── AI providers — configure at least one supported route ─────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
XAI_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY_1=
OMNIROUTE_API_KEY_2=
OMNIROUTE_API_KEY_3=

# Optional reference search and image generation
FIRECRAWL_API_KEY=
IMAGE_API_KEY=
IMAGE_API_URL=
IMAGE_MODEL=gpt-image-1
OPENAI_API_KEY=

# ── Razorpay one-time Pro passes (use Test Mode in staging) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Mega Test external/provider tasks ─────────────────────────────────────────
# Keep false until a real AdMob app, rewarded unit, and signed SSV test pass.
ADMOB_TASKS_ENABLED=false
# Preferred JSON map, e.g. {"partner-id":"random-secret-at-least-32-characters"}
MEGA_TASK_PARTNER_SECRETS=
# Optional single-partner fallback
MEGA_TASK_PARTNER_ID=
MEGA_TASK_PARTNER_SECRET=
# Admin-only Get Task catalog import
MEGA_TASK_CATALOG_PROVIDER_ID=
MEGA_TASK_CATALOG_URL=
MEGA_TASK_CATALOG_BEARER_TOKEN=

# ── Operational alerts (not authentication) ───────────────────────────────────
TELEGRAM_API_KEY=
TELEGRAM_API_KEY_1=
REPORT_TELEGRAM_CHAT_ID=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── GitHub Actions repository variables (Android build, not Vercel) ───────────
APP_HOST=YOUR-STAGING-DEPLOYMENT.vercel.app
CAPACITOR_SERVER_URL=https://YOUR-STAGING-DEPLOYMENT.vercel.app
ADMOB_ANDROID_APP_ID=
APP_VERSION_NAME=1.0.1
APP_VERSION_CODE=

# ── GitHub Actions repository secrets (Android signing, not Vercel) ────────────
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
