# Last Topper environment-variable template
# Copy names only. Never commit populated production secrets.

# Supabase server configuration — Vercel Production
SUPABASE_URL=https://hcqlwtmeylnhqernwljj.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_HOOK_SECRET=

# Browser-visible configuration — Vercel Production
# Never expose the service-role key through a VITE_* variable.
VITE_SUPABASE_URL=https://hcqlwtmeylnhqernwljj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_APP_URL=https://last-topper-web-test.vercel.app

# AI providers — configure at least one
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
XAI_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY_1=
OMNIROUTE_API_KEY_2=
OMNIROUTE_API_KEY_3=

# Optional reference search and image generation
FIRECRAWL_API_KEY=
IMAGE_API_KEY=
IMAGE_API_URL=
IMAGE_MODEL=gpt-image-1
OPENAI_API_KEY=

# Razorpay one-time Pro passes — use matching Test Mode values first
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mega Test provider tasks
# Keep false until a real AdMob app, rewarded unit, and signed SSV test pass.
ADMOB_TASKS_ENABLED=false
# Preferred multi-partner JSON map, for example:
# {"partner-id":"a-random-secret-at-least-32-characters"}
MEGA_TASK_PARTNER_SECRETS=
# Optional single-partner fallback
MEGA_TASK_PARTNER_ID=
MEGA_TASK_PARTNER_SECRET=
# Admin-only Get Task catalog import. The provider ID must match a callback
# partner above. The bearer token remains server-only.
MEGA_TASK_CATALOG_PROVIDER_ID=
MEGA_TASK_CATALOG_URL=
MEGA_TASK_CATALOG_BEARER_TOKEN=

# Optional operational alerts and WhatsApp automation (not authentication)
TELEGRAM_API_KEY_1=
REPORT_TELEGRAM_CHAT_ID=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Native build values belong in GitHub Actions repository Variables, not Vercel.
APP_HOST=last-topper-web-test.vercel.app
CAPACITOR_SERVER_URL=https://last-topper-web-test.vercel.app
ADMOB_ANDROID_APP_ID=
APP_VERSION_NAME=1.0.1
APP_VERSION_CODE=

# Android signing values belong in GitHub Actions repository Secrets.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
